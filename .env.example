# LearnSphere AI - Environment Configuration Example
# Copy this file to .env and fill in your values if using live LLM APIs.
# The application runs in full Demo/Local RAG mode without any API keys.

# Backend Port (FastAPI)
PORT=8000
BACKEND_HOST=http://localhost:8000

# Optional LLM API Keys (Keep on backend only; never expose in frontend)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local Model Mode (true = use local deterministic RAG + TF-IDF, false = call LLM API)
USE_LOCAL_FALLBACK=true

# Database Path
DATABASE_PATH=learnsphere.db
